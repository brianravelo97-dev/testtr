# Copie este archivo como .env (el servidor lo crea automáticamente si no existe)
PORT=3001
# Zona horaria usada para horarios de acceso y reportes
TZ=America/Santiago
# Clave secreta para firmar JWT (use un valor largo y aleatorio)
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria
JWT_EXPIRES=8h
# Clave (64 caracteres hex) para cifrar los PIN de personas (necesario para sincronizar con lectores)
PIN_ENC_KEY=
# Ruta del archivo SQLite
DB_PATH=./data/control-acceso.db
# Intervalo (segundos) en que el simulador genera eventos aleatorios. 0 = desactivado
SIM_EVENT_INTERVAL=45
# Intervalo (segundos) para verificar estado de los dispositivos
DEVICE_CHECK_INTERVAL=30
# Orígenes permitidos para CORS (separados por coma). Vacío = mismo origen / red local
CORS_ORIGIN=
